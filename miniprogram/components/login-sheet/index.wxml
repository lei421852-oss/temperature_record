<view class="mask" wx:if="{{visible}}" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">完善登录信息</view>
    <view class="sheet-sub">头像与昵称将展示在「我的」页面，仅本次选择</view>

    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <text wx:else class="avatar-placeholder">选择头像</text>
    </button>

    <input class="nickname-input" type="nickname" placeholder="点击输入昵称（微信可辅助填写）" bindinput="onNicknameInput" />

    <button class="confirm-btn" bindtap="onConfirm">确认登录</button>
    <button class="cancel-btn" bindtap="onClose">取消</button>
  </view>
</view>
