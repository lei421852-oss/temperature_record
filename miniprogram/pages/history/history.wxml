<view class="page">
  <!-- 月历：温度 + 月经标记 -->
  <view class="card cal-card">
    <view class="cal-header">
      <view class="cal-nav" bindtap="prevMonth">‹</view>
      <view class="cal-title">{{monthLabel}}</view>
      <view class="cal-nav" bindtap="nextMonth">›</view>
    </view>
    <view class="cal-week">
      <view class="cal-week-cell" wx:for="{{weekLabels}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="cal-grid">
      <block wx:for="{{days}}" wx:key="key">
        <view wx:if="{{item.empty}}" class="cal-cell empty"></view>
        <view wx:else class="cal-cell {{item.recorded ? 'recorded' : ''}} {{item.menstruation ? 'menstruation' : ''}} {{item.runStart ? 'run-start' : ''}} {{item.runEnd ? 'run-end' : ''}}" data-date="{{item.date}}" data-recorded="{{item.recorded}}" bindtap="onDayTap">
          <view class="cal-day {{item.isToday ? 'today' : ''}} {{item.menstruation ? 'menstruation' : ''}} {{item.recorded ? '' : 'unrecorded'}}">{{item.day}}</view>
          <view class="cal-temp {{item.menstruation ? 'menstruation' : ''}}" wx:if="{{item.recorded}}">{{item.tempText}}</view>
        </view>
      </block>
    </view>
    <view class="cal-legend">
      <view class="legend-item"><view class="legend-dot gray"></view>未记录</view>
      <view class="legend-item"><view class="legend-dot pink"></view>已记录</view>
      <view class="legend-item"><view class="legend-dot red"></view>月经期</view>
    </view>
  </view>

  <!-- 月经记录（可删除，误操作纠错） -->
  <view class="card period-card" wx:if="{{periods.length}}">
    <view class="period-card-title">月经记录（{{periods.length}} 次）</view>
    <view class="period-item" wx:for="{{periods}}" wx:key="_id">
      <view class="period-label">{{item.label}}</view>
      <view class="period-del-btn" data-id="{{item._id}}" bindtap="onPeriodDel">删除</view>
    </view>
  </view>

  <view class="list-tip" wx:if="{{records.length}}">共 {{records.length}} 条记录 · 点击可修改</view>

  <view class="record-card" wx:for="{{records}}" wx:key="date" data-id="{{item._id}}" bindtap="goDetail">
    <view class="record-left">
      <view class="record-date">{{item.dateCN}}</view>
      <view class="record-created">记录于 {{item.createdText}}</view>
    </view>
    <view class="record-temp">
      <text class="num">{{item.temp}}</text><text class="unit">℃</text>
    </view>
  </view>

  <view class="empty" wx:if="{{empty && !loading}}">还没有任何记录，去首页记录第一条吧</view>
  <view class="loading" wx:if="{{loading}}">加载中…</view>
</view>
