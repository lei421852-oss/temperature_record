.page {
  padding: 24rpx 32rpx 60rpx;
}

/* ---------- 月历 ---------- */
.cal-card {
  padding: 24rpx 20rpx 20rpx;
  margin-bottom: 24rpx;
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 16rpx;
}

.cal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.cal-nav {
  font-size: 44rpx;
  color: #999;
  padding: 0 24rpx;
  line-height: 1;
}

.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}

.cal-week-cell {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.28%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100rpx;
  padding: 8rpx 0 10rpx;
  border-radius: 12rpx;
}

/* 已记录（非月经期）：白色高亮 */
.cal-cell.recorded {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.14);
}

/* 月经期：淡红长带（连续日子连成一条，两端带弧度） */
.cal-cell.menstruation {
  background: #ffebee;
  border-radius: 0;
  box-shadow: none;
}

.cal-cell.menstruation.run-start {
  border-top-left-radius: 26rpx;
  border-bottom-left-radius: 26rpx;
}

.cal-cell.menstruation.run-end {
  border-top-right-radius: 26rpx;
  border-bottom-right-radius: 26rpx;
}

.cal-day {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
}

/* 未记录：置灰 */
.cal-day.unrecorded {
  color: #ccc;
  font-weight: 400;
}

.cal-day.today {
  border: 2rpx solid #ff6b6b;
  box-sizing: border-box;
  line-height: 52rpx;
}

/* 月经期：红色圈圈 */
.cal-day.menstruation {
  color: #e91e63;
  border: 2rpx solid #e91e63;
  box-sizing: border-box;
  line-height: 52rpx;
}

.cal-temp {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #ff6b6b;
}

.cal-temp.menstruation {
  color: #e91e63;
}

.cal-legend {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
  padding-right: 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  font-size: 20rpx;
  color: #999;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.legend-dot.gray {
  background: #ddd;
}

.legend-dot.pink {
  background: #ffb3c1;
}

.legend-dot.red {
  background: #e91e63;
}

/* ---------- 记录列表 ---------- */
.list-tip {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 8rpx 20rpx;
}

.record-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.record-date {
  font-size: 32rpx;
  font-weight: 600;
}

.record-created {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.record-temp .num {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff6b6b;
}

.record-temp .unit {
  font-size: 28rpx;
  color: #ff6b6b;
}

.empty,
.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 120rpx 0;
}

/* ---------- 月经记录管理 ---------- */
.period-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.period-card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.period-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f2f2f2;
  padding: 18rpx 0;
}

.period-item:first-of-type {
  border-top: none;
}

.period-label {
  font-size: 28rpx;
  color: #333;
}

.period-del-btn {
  font-size: 24rpx;
  color: #e53935;
  border: 2rpx solid #ffb3b8;
  border-radius: 28rpx;
  padding: 6rpx 24rpx;
}
