.page {
  padding: 24rpx 32rpx 60rpx;
}

.header {
  padding: 40rpx 8rpx 24rpx;
}

.date-big {
  font-size: 44rpx;
  font-weight: 700;
}

.date-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.temp-card {
  padding: 48rpx 40rpx 36rpx;
  margin-top: 16rpx;
}

.temp-value {
  text-align: center;
  margin-bottom: 24rpx;
}

.temp-num {
  font-size: 120rpx;
  font-weight: 700;
  color: #ff6b6b;
  line-height: 1.1;
}

.temp-unit {
  font-size: 44rpx;
  color: #ff6b6b;
  margin-left: 6rpx;
}

.temp-picker {
  width: 100%;
  height: 240rpx;
  margin: 8rpx 0 12rpx;
}

.picker-item {
  height: 68rpx;
  line-height: 68rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #555;
  text-align: center;
}

.temp-range {
  text-align: center;
  font-size: 24rpx;
  color: #aaa;
}

.hint {
  margin: 20rpx 8rpx 0;
  font-size: 26rpx;
  color: #888;
}

.save-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff4757);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 71, 87, 0.3);
}

.save-btn[disabled] {
  background: #ffb3b8;
  color: #fff;
}

.nav-row {
  display: flex;
  margin-top: 32rpx;
}

.nav-card {
  flex: 1;
  padding: 32rpx 28rpx;
}

.nav-card:first-child {
  margin-right: 24rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
}

.nav-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}
