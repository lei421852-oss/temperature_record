<view class="page">
  <!-- 顶部：日期（点击可选择过去日期补记） -->
  <view class="header">
    <picker mode="date" value="{{selectedDate}}" end="{{today}}" bindchange="onDateChange">
      <view class="date-big">{{selectedDateCN}}</view>
      <view class="date-sub">{{isBackfill ? '补记 · 点击可换日期' : '今日记录 · 点击可换日期'}}</view>
    </picker>
  </view>

  <!-- 首次登录提示（未登录时显示） -->
  <view class="login-banner" wx:if="{{!loggedIn}}">
    <view class="login-banner-text">欢迎使用体温记录 · 登录后数据按微信账号独立保存</view>
    <button class="login-btn" bindtap="onLoginTap">微信登录</button>
  </view>

  <!-- 体温滚动选择（以 0.1 为单位） -->
  <view class="card temp-card">
    <view class="temp-value">
      <text class="temp-num">{{temp}}</text>
      <text class="temp-unit">℃</text>
    </view>
    <picker-view class="temp-picker" value="{{pickerValue}}" indicator-style="height: 68rpx;" bindchange="onPickerChange">
      <picker-view-column>
        <view class="picker-item" wx:for="{{tempOptions}}" wx:key="*this">{{item}}</view>
      </picker-view-column>
    </picker-view>
    <view class="temp-range">{{tempMin}}℃ — {{tempMax}}℃ · 以 0.1 为单位滚动选择</view>
  </view>

  <!-- 提示：当前默认值的来源 -->
  <view class="hint">{{hint}}</view>

  <!-- 账号：数据按微信账号独立保存 -->
  <view class="account-line">数据按微信账号独立保存 · 当前账号：{{accountText}}</view>

  <button class="save-btn" bindtap="onSave" disabled="{{saving || !loaded}}">
    {{saving ? '保存中…' : (hasRecord ? '更新记录' : (isBackfill ? '补记该日' : '保存今日记录'))}}
  </button>

  <!-- 月经记录：点击开始 / 再点结束（按所选日期） -->
  <button class="period-btn {{periodActive ? 'active' : ''}}" bindtap="onPeriodTap" disabled="{{!loaded}}">
    {{periodBtnText}}
  </button>
  <view class="period-hint" wx:if="{{periodActive}}">
    月经进行中 · 始于 {{periodStart}}
    <text class="period-del" bindtap="onPeriodDelete">误点？删除本次</text>
  </view>

  <!-- 功能入口 -->
  <view class="nav-row">
    <view class="card nav-card" bindtap="goHistory">
      <view class="nav-title">历史记录</view>
      <view class="nav-desc">查看 / 修改 / 删除</view>
      <view class="nav-desc">创建时间精确到秒 · 修改日志</view>
    </view>
    <view class="card nav-card" bindtap="goChart">
      <view class="nav-title">温度曲线</view>
      <view class="nav-desc">折线图</view>
      <view class="nav-desc">导出到相册 / 分享</view>
    </view>
  </view>

  <!-- 登录面板：头像昵称填写 -->
  <login-sheet visible="{{showLoginSheet}}" bind:login="onLoginSheet" bind:close="onLoginSheetClose" />
</view>
