.page {
  padding: 24rpx 32rpx 60rpx;
}

.chart-card {
  padding: 28rpx 20rpx 20rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 12rpx 16rpx;
}

.chart {
  width: 100%;
  height: 500rpx;
}

.chart-tip {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 12rpx 0 4rpx;
}

.export-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #ff6b6b, #ff4757);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 92rpx;
  line-height: 92rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 71, 87, 0.3);
}

.export-btn[disabled] {
  background: #ffb3b8;
  color: #fff;
}

.empty,
.loading {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
